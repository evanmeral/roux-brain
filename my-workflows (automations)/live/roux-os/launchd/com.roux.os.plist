<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roux.os</string>
  <!-- node runs the server directly. macOS files the Desktop-folder grant under "node" in
       System Settings > Privacy & Security > Files and Folders; that toggle is what lets it
       read the vault. No dialogs: node has no UI, and a refused start just logs and retries
       once a minute. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/server.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
